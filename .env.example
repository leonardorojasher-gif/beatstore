# Variables de entorno de BeatStore. En local son opcionales (hay valores por defecto).
# En la nube se configuran en el panel del proveedor; nunca se suben a GitHub.
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DATA_DIR=./instance

# Pasarela de pago: "sandbox" (simulada). En producción: adaptador de Webpay Plus.
PASARELA_PAGO=sandbox

# Correo: "consola" (bandeja de demo en el panel) o "smtp" (proveedor de correo transaccional)
CORREO_BACKEND=consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=BeatStore <no-responder@beatstore.cl>
CORREO_PRODUCTOR=productor@beatstore.cl
